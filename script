    end

    if not SelectedPlayer then

        Status.Text =
            "●  Select a player first."

        Status.TextColor3 =
            Color3.fromRGB(255, 130, 135)

        return
    end

    TPLoopEnabled = true

    TPLoopButton.Text =
        "TP LOOP   •   ACTIVATED"

    SetButtonState(
        TPLoopButton,
        true,
        COLORS.AccentDark
    )

    Status.Text =
        "●  TP Loop ativo: " ..
        SelectedPlayer.Name

    Status.TextColor3 =
