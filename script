                            GetVisibleTargetPart(
                                Character
                            )

                        if Part then

                            local Distance =
                                (
                                    Camera.CFrame.Position -
                                    Part.Position
                                ).Magnitude

                            if Distance <
                                ClosestDistance
                            then

                                ClosestDistance =
                                    Distance

                                ClosestPlayer =
                                    Player
                            end
                        end
                    end
                end
            end
        end
    end

    return ClosestPlayer
