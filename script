local function RemoveAura(Character)

    if not Character then
        return
    end

    local Aura =
        Character:FindFirstChild(
            AURA_NAME
        )

    if Aura then
        Aura:Destroy()
    end
end

local function AddAura(Player)

    if Player == LocalPlayer then
        return
    end

    local Character =
        Player.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid
        or Humanoid.Health <= 0
    then
        return
    end

    if Character:FindFirstChild(
        AURA_NAME
    ) then
        return
    end

    local Highlight =
        Instance.new("Highlight")

    Highlight.Name =
        AURA_NAME

    Highlight.FillColor =
        Color3.fromRGB(
            0,
            255,
            70
        )

    Highlight.OutlineColor =
        Color3.fromRGB(
            0,
            255,
            70
        )

    Highlight.FillTransparency = 0.55
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    Highlight.Parent =
        Character
end

local function UpdateAllAuras()

    for _, Player in ipairs(
        Players:GetPlayers()
    ) do

        if Player ~= LocalPlayer then

            if AuraEnabled then
                AddAura(Player)
            else
                RemoveAura(Player.Character)
            end
        end
    end
end

