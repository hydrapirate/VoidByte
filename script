local function ConsolePrint(Text)

    Text = tostring(Text)

    if ConsoleOutput.Text == "" then

        ConsoleOutput.Text = Text

    else

        ConsoleOutput.Text =
            ConsoleOutput.Text ..
            "\n" ..
            Text
    end
end

local function ExecuteLuaCode(Source)

    if not Source
        or Source:gsub("%s+", "") == ""
    then

        ConsolePrint(
            "[VoidByte] No code provided."
        )

        Status.Text =
            "●  Console: empty code"

        Status.TextColor3 =
            Color3.fromRGB(255, 130, 135)

        return
    end

    ConsolePrint(
        "> " .. Source
    )

    local LoadFunction =
        loadstring

    if type(LoadFunction) ~= "function" then

        ConsolePrint(
            "[ERRO] loadstring is not available in this environment."
        )

        ConsolePrint(
            "[INFO] A standard Roblox LocalScript cannot execute arbitrary Lua code."
        )

        ConsolePrint(
            "[INFO] For secure game logic, use Scripts/ModuleScripts."
        )

        Status.Text =
            "●  Console unavailable in this environment"

        Status.TextColor3 =
            Color3.fromRGB(255, 130, 135)

        return
    end

    local Success, ChunkOrError =
        pcall(function()

            return LoadFunction(Source)

        end)

    if not Success then

        ConsolePrint(
            "[COMPILATION ERROR] " ..
            tostring(ChunkOrError)
        )

        Status.Text =
            "●  Error compiling Lua"

        Status.TextColor3 =
            Color3.fromRGB(255, 130, 135)

        return
    end

    if type(ChunkOrError) ~= "function" then

        ConsolePrint(
            "[ERRO] Invalid Lua code."
        )

        Status.Text =
            "●  Código Invalid"

        Status.TextColor3 =
            Color3.fromRGB(255, 130, 135)

        return
    end

    local ExecuteSuccess, Result =
        pcall(function()

            return ChunkOrError()

        end)

    if ExecuteSuccess then

        ConsolePrint(
            "[OK] Code executed."
        )

        if Result ~= nil then

            ConsolePrint(
                "[RETURN] " ..
                tostring(Result)
            )
        end

        Status.Text =
            "●  Lua executed successfully"

        Status.TextColor3 =
            Color3.fromRGB(105, 210, 135)

    else

        ConsolePrint(
            "[EXECUTION ERROR] " ..
            tostring(Result)
        )

        Status.Text =
            "●  Lua execution error"

        Status.TextColor3 =
            Color3.fromRGB(255, 130, 135)

        warn(
            "VoidByte Console:",
            Result
        )
    end
end

