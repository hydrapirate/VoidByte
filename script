local function TeleportToSelectedPlayer()

    if not TPLoopEnabled then
        return
    end

    if not SelectedPlayer
        or not SelectedPlayer.Parent
    then

        StopTPLoop()

        SelectedPlayer = nil

        SelectedLabel.Text =
            "Nenhum jogador selecionado"

        Status.Text =
            "●  TP Loop parado"

        Status.TextColor3 =
            Color3.fromRGB(255, 130, 135)

        return
    end

    local Character =
        LocalPlayer.Character

    local TargetCharacter =
        SelectedPlayer.Character

    if not Character or not TargetCharacter then
        return
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local TargetRoot =
        TargetCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if Root and TargetRoot then
        -- +Z local do alvo fica exatamente atrás das costas dele.
        -- O offset é pequeno para deixar o player praticamente colado.
        Root.CFrame =
            TargetRoot.CFrame *
            CFrame.new(0, 0, 1.5)
    end
end

