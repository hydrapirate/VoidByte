RunService:BindToRenderStep(
    "VoidByteTargetLock",
    Enum.RenderPriority.Camera.Value + 1,
    function()

        local Camera =
            workspace.CurrentCamera

        if not Camera then
            return
        end

        if MiraLockEnabled
            and MiraHolding
        then

            if not IsValidMiraTarget(
                MiraTarget
            ) then

                MiraTarget =
                    GetClosestEnemyInFOV()
            end

            if MiraTarget then

                local Character =
                    MiraTarget.Character

                local Part =
                    GetVisibleTargetPart(
                        Character
                    )

                if Part then

                    Camera.CFrame =
                        CFrame.lookAt(
                            Camera.CFrame.Position,
                            Part.Position
                        )
                end
            end

            return
        end

        if not TargetLockEnabled
            and not EnemyTargetLockEnabled
        then
            return
        end

        local Target =
            GetClosestPlayer(
                EnemyTargetLockEnabled
            )

        if not Target then
            return
        end

        local Character =
            Target.Character

        local Part =
            GetVisibleTargetPart(
                Character
            )

        if not Part then
            return
        end

        Camera.CFrame =
            CFrame.lookAt(
                Camera.CFrame.Position,
                Part.Position
            )
    end
)

