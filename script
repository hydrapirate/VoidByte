--========================================================
-- VEHICLE
--========================================================

local function GetVehicleSeat()

    local Character =
        LocalPlayer.Character

    if not Character then
        return nil
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then
        return nil
    end

    local Seat =
        Humanoid.SeatPart

    if Seat
        and Seat:IsA("VehicleSeat")
    then
        return Seat
    end

    return nil
end

local function GetVehicleRoot(Seat)

    if not Seat then
        return nil
    end

    local Model =
        Seat:FindFirstAncestorOfClass(
            "Model"
        )

    if not Model then

        return Seat.AssemblyRootPart
            or Seat
    end

    if Model.PrimaryPart then
        return Model.PrimaryPart
    end

    return Seat.AssemblyRootPart
        or Seat
end

local function StopVehicleFly()

    if VehicleVelocity then

        VehicleVelocity.VectorVelocity =
            Vector3.zero

        VehicleVelocity:Destroy()

        VehicleVelocity = nil
    end

    if VehicleOrientation then

        VehicleOrientation:Destroy()

        VehicleOrientation = nil
    end

    if VehicleAttachment then

        VehicleAttachment:Destroy()

        VehicleAttachment = nil
    end

    if VehicleOrientationAttachment then

        VehicleOrientationAttachment:Destroy()

        VehicleOrientationAttachment = nil
    end

    FlyingVehicle = nil
    FlyingVehicleRoot = nil
end

local function StartVehicleFly(Seat)

    local Root =
        GetVehicleRoot(Seat)

    if not Root then
        return false
    end

    StopVehicleFly()

    FlyingVehicle = Seat
    FlyingVehicleRoot = Root

    VehicleAttachment =
        Instance.new("Attachment")

    VehicleAttachment.Parent =
        Root

    VehicleVelocity =
        Instance.new("LinearVelocity")

    VehicleVelocity.Attachment0 =
        VehicleAttachment

    VehicleVelocity.RelativeTo =
        Enum.ActuatorRelativeTo.World

    VehicleVelocity.MaxForce =
        math.huge

    VehicleVelocity.VectorVelocity =
        Vector3.zero

    VehicleVelocity.Parent =
        Root

    VehicleOrientationAttachment =
        Instance.new("Attachment")

    VehicleOrientationAttachment.Parent =
        Root

    VehicleOrientation =
        Instance.new("AlignOrientation")

    VehicleOrientation.Attachment0 =
        VehicleOrientationAttachment

    VehicleOrientation.Mode =
        Enum.OrientationAlignmentMode.OneAttachment

    VehicleOrientation.RigidityEnabled = true
    VehicleOrientation.MaxTorque = math.huge
    VehicleOrientation.Responsiveness = 200
    VehicleOrientation.Parent = Root

    return true
end

--========================================================
-- STOP FLY
--========================================================

local function StopFlying()

    Flying = false

    if FlyConnection then

        FlyConnection:Disconnect()

        FlyConnection = nil
    end

    if FlyVelocity then

        FlyVelocity.VectorVelocity =
            Vector3.zero

        FlyVelocity:Destroy()

        FlyVelocity = nil
    end

    if FlyOrientation then

        FlyOrientation:Destroy()

        FlyOrientation = nil
    end

    if FlyAttachment then

        FlyAttachment:Destroy()

        FlyAttachment = nil
    end

    if FlyOrientationAttachment then

        FlyOrientationAttachment:Destroy()

        FlyOrientationAttachment = nil
    end

    StopVehicleFly()

    local Character =
        LocalPlayer.Character

    if Character then

        local Humanoid =
            Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if Humanoid then

            Humanoid.PlatformStand = false
            Humanoid.AutoRotate = true
        end
    end

    for Key in pairs(FlyKeys) do
        FlyKeys[Key] = false
    end
end

--========================================================
-- START FLY
--========================================================

local function StartFlying()

    if not FlyEnabled
        or Flying
    then
        return
    end

    local Character =
        LocalPlayer.Character

    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid
        or Humanoid.Health <= 0
    then
        return
    end

    local Seat =
        GetVehicleSeat()

    if Seat then

        if not StartVehicleFly(
            Seat
        ) then
            return
        end

        Flying = true

        Humanoid.PlatformStand = false
        Humanoid.AutoRotate = false

    else

        local Root =
            Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not Root then
            return
        end

        Flying = true

        Humanoid.PlatformStand = true
        Humanoid.AutoRotate = false

        FlyAttachment =
            Instance.new("Attachment")

        FlyAttachment.Parent =
            Root

        FlyVelocity =
            Instance.new("LinearVelocity")

        FlyVelocity.Attachment0 =
            FlyAttachment

        FlyVelocity.RelativeTo =
            Enum.ActuatorRelativeTo.World

        FlyVelocity.MaxForce =
            math.huge

        FlyVelocity.Parent =
            Root

        FlyOrientationAttachment =
            Instance.new("Attachment")

        FlyOrientationAttachment.Parent =
            Root

        FlyOrientation =
            Instance.new("AlignOrientation")

        FlyOrientation.Attachment0 =
            FlyOrientationAttachment

        FlyOrientation.Mode =
            Enum.OrientationAlignmentMode.OneAttachment

        FlyOrientation.RigidityEnabled = true
        FlyOrientation.MaxTorque = math.huge
        FlyOrientation.Responsiveness = 200
        FlyOrientation.Parent = Root
    end

    Status.Text =
        "●  Fly ativo • E para parar"

    Status.TextColor3 =
        Color3.fromRGB(
            105,
            230,
            135
        )

    FlyConnection =
        RunService.RenderStepped:Connect(
            function()

                if not Flying then
                    return
                end

                local CharacterNow =
                    LocalPlayer.Character

                if not CharacterNow then

                    StopFlying()

                    return
                end

                local HumanoidNow =
                    CharacterNow:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if not HumanoidNow
                    or HumanoidNow.Health <= 0
                then

                    StopFlying()

                    return
                end

                local Camera =
                    workspace.CurrentCamera

                if not Camera then
                    return
                end

                local Look =
                    Camera.CFrame.LookVector

                local Right =
                    Camera.CFrame.RightVector

                local Direction =
                    Vector3.zero

                if FlyKeys.W then
                    Direction += Look
                end

                if FlyKeys.S then
                    Direction -= Look
                end

                if FlyKeys.D then
                    Direction += Right
                end

                if FlyKeys.A then
                    Direction -= Right
                end

                if FlyKeys.Up then
                    Direction += Vector3.yAxis
                end

                if FlyKeys.Down then
                    Direction -= Vector3.yAxis
                end

                if Direction.Magnitude > 0 then

                    Direction =
                        Direction.Unit *
                        FlySpeed
                end

                local CurrentSeat =
                    GetVehicleSeat()

                if CurrentSeat then

                    HumanoidNow.PlatformStand =
                        false

                    HumanoidNow.AutoRotate =
                        false

                    local VehicleRoot =
                        GetVehicleRoot(
                            CurrentSeat
                        )

                    if VehicleRoot then

                        if FlyingVehicleRoot
                            ~= VehicleRoot
                        then

                            StartVehicleFly(
                                CurrentSeat
                            )
                        end

                        if VehicleVelocity then

                            VehicleVelocity.VectorVelocity =
                                Direction
                        end

                        local Flat =
                            Vector3.new(
                                Look.X,
                                0,
                                Look.Z
                            )

                        if Flat.Magnitude >
                            0.001
                            and VehicleOrientation
                        then

                            VehicleOrientation.CFrame =
                                CFrame.lookAt(
                                    Vector3.zero,
                                    Flat.Unit
                                )
                        end
                    end

                else

                    if FlyingVehicle then
                        StopVehicleFly()
                    end

                    HumanoidNow.PlatformStand =
                        true

                    HumanoidNow.AutoRotate =
                        false

                    local Root =
                        CharacterNow:FindFirstChild(
                            "HumanoidRootPart"
                        )

                    if not Root then

                        StopFlying()

                        return
                    end

                    if FlyVelocity then

                        FlyVelocity.VectorVelocity =
                            Direction
                    end

                    local Flat =
                        Vector3.new(
                            Look.X,
                            0,
                            Look.Z
                        )

                    if Flat.Magnitude >
                        0.001
                        and FlyOrientation
                    then

                        FlyOrientation.CFrame =
                            CFrame.lookAt(
                                Vector3.zero,
                                Flat.Unit
                            )
                    end
                end
            end
        )
end

