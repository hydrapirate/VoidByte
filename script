local NamesEnabled = false
local NameTags = {}

local function RemoveNameTag(Player)

    local Tag = NameTags[Player]

    if Tag then
        Tag:Destroy()
        NameTags[Player] = nil
    end
end

local function CreateNameTag(Player)

